# Tangy Sessions — Custom Email Sender configuration.
# Copy to .env for local use (.env is git-ignored). In production set these as
# environment variables on the host; never commit real values.

# Public origin the app is served from. Required in production and must be
# https. Requests from any other origin are refused.
APP_ORIGIN=http://localhost:8787
PORT=8787
# HOST=127.0.0.1          # default 127.0.0.1 in development, 0.0.0.0 in production
# NODE_ENV=production

# Where the SQLite database lives (template, admin accounts, sessions, send
# log). Must be on a persistent disk in production.
DATA_DIR=./data

# Signs preview tokens. Required in production; every instance must share it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates outstanding previews (admins just preview again).
# Leave empty here — put the real value in .env or the host's secret settings.
PREVIEW_TOKEN_SECRET=

# --- Database ------------------------------------------------------------------
# sqlite (default): the file in DATA_DIR — nothing else needed.
# postgres: used ONLY when explicitly set. Run `npm run db:migrate` first.
# Production must set DB_BACKEND explicitly; Vercel requires postgres.
DB_BACKEND=sqlite
# Runtime connection: a LOGIN role that is a member of mailer_runtime
# (never the schema owner). Supabase: the Transaction pooler (port 6543).
# Server-side secret — leave empty here.
DATABASE_URL=
# Schema-owner connection for migrations and the admin CLI only — local use,
# never on the running app / Vercel. Must be session-preserving: Supabase
# Session pooler or direct connection (port 5432). Port 6543 is refused.
# Keep it in a separate git-ignored file (e.g. .env.migrate), not here.
MIGRATION_DATABASE_URL=
# TLS: verify (default — certificate verification) | disable (localhost only)
# DATABASE_SSL=verify
# Extra trusted CA, only if verification against Node's built-in CAs fails.
# Set ONE of: the PEM contents (e.g. a Vercel env var) or a local file path.
# DATABASE_SSL_CA_PEM=
# DATABASE_SSL_CA=/path/to/provider-ca.pem
# PG_POOL_MAX=3
# PG_CONNECT_TIMEOUT_MS=5000
# PG_QUERY_TIMEOUT_MS=15000          # client-side limit on every query
# PG_STATEMENT_TIMEOUT_MS=10000      # SET LOCAL in every transaction (+ startup param)
# PG_IDLE_TX_TIMEOUT_MS=15000        # SET LOCAL in every transaction (+ startup param)
# Connection startup parameters: all (default) | none | comma list of
# application_name,statement_timeout,idle_in_transaction_session_timeout.
# Use none if the pooler rejects them; set role-level timeouts instead.
# PG_STARTUP_PARAMS=all

# Set to true only when running behind a reverse proxy you control that sets
# X-Forwarded-For (used for login rate limiting). Required (true) on Vercel.
# TRUST_PROXY=false

# --- Email (Resend) -----------------------------------------------------------
# Server-side only. Never prefix with VITE_/NEXT_PUBLIC_ or expose to a browser.
RESEND_API_KEY=
# Sender identity. There is deliberately no default: set it only once the
# domain is verified in Resend (Resend dashboard → Domains).
EMAIL_FROM=noreply@tangysessions.com
# EMAIL_FROM="Tangy Sessions <hello@tangysessions.com>"
# Optional. When set it must be a valid address or "Name <address>" (startup fails otherwise).
# EMAIL_REPLY_TO=

# true = render and log everything but never call Resend (local testing).
# Accepted: true/1/yes/on (dry run) or false/0/no/off (real sending), any case.
# Any other value stops startup. Not set: dry run in development; production
# refuses to start until it is set explicitly.
EMAIL_DRY_RUN=true

# Per-admin limit on send attempts (real + test) in any 10-minute window.
# Whole number 1–1000 (default 30); any other value stops startup.
# SEND_LIMIT_PER_10_MIN=30
# Resend request timeout in ms: whole number 1000–25000 (default 15000).
# RESEND_TIMEOUT_MS=15000
